# Jev-Router configuration template.
#
# Copy this file to ".env" (or run: npm run setup:key), then fill in values.
# Priority: real environment variables > .env > built-in defaults.
# ".env" is ignored by Git; never commit it and never paste its contents anywhere.

# --- Decision provider ---
# The router asks a decision provider which model to use for each new turn.
# typesafe = official Jev (needs a key), static = rule-based, no network calls.
TYPESAFE_API_KEY=
JEV_DECISION_PROVIDER=typesafe
JEV_ROUTE_TIMEOUT_MS=800
# Decision API endpoint: official TypeSafe or a relay that proxies /v1/systemone.
# Relays often answer in 1-4s; raise JEV_ROUTE_TIMEOUT_MS so decisions are not
# all skipped by fail-open (800 is the plan default, 4000 works with PackyCode).
# JEV_TYPESAFE_ENDPOINT=https://www.packyapi.ai/v1/systemone
# JEV_TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# JEV_TYPESAFE_MODEL=jev-latest

# --- Fallback execution model ---
# Used when the preferred model cannot be reached, or when no decision is available.
JEV_FALLBACK_PROVIDER=deepseek
# Copy the model id from the "model" line in your Codex config, for example:
#   deepseek/deepseek-flash
JEV_FALLBACK_MODEL=

# --- Fallback provider endpoint (OpenAI-compatible) ---
# Base URL that serves JEV_FALLBACK_MODEL. Leave DEEPSEEK_API_KEY empty when the
# endpoint handles authentication itself (for example a local router on 127.0.0.1).
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
# Protocol for DEEPSEEK_BASE_URL: "responses" (Codex native) or "chat"
# (OpenAI-compatible chat completions). Leave unset for "responses".
# DEEPSEEK_WIRE_API=responses

# --- Codex upstream ---
JEV_CODEX_UPSTREAM_URL=https://api.openai.com/v1/responses
# Optional: full path to the Codex executable when it is not on PATH.
# JEV_CODEX_BIN=

# --- Optional model runtime probes ---
# JEV_OPENAI_BASE_URL=
# OPENAI_API_KEY=
# JEV_OLLAMA_URL=http://127.0.0.1:11434
# JEV_LMSTUDIO_URL=http://127.0.0.1:1234

# --- Privacy and local data ---
# cloud = decisions and execution may use remote providers.
# local-routing = decisions stay local, execution may be remote.
# local-only = decisions and execution must both stay local.
JEV_PRIVACY_MODE=cloud
JEV_ALLOW_LONG=0
JEV_LOG_EXCERPT=0
# --- Desktop integration (jev desktop enable/status/disable) ---
# Fixed local port for the desktop proxy. Must be free when enabling.
# JEV_PROXY_PORT=10300
# Model ids that trigger automatic routing (comma separated).
# JEV_SENTINEL_MODELS=jev-router,jev/auto
# Rewrite reasoning effort to "low" for simple routed tasks (1 = on, 0 = off).
# JEV_ADJUST_REASONING=1
# Upstream header deadline in ms (must stay below Codex's own ~113s patience).
# JEV_UPSTREAM_TIMEOUT_MS=60000
# JEV_DATA_DIR=
# JEV_PROFILES_DIR=
